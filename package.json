{
  "name": "works",
  "version": "0.1.0",
  "private": true,
  "description": "Naoki Yoshida の制作活動ハブ。自作アプリ・開発支援ツール・開発と学習の仕組み・技術記事を紹介する静的サイト",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "node scripts/check-public-profile.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:home": "node scripts/check-home.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:articles": "node scripts/check-articles.mjs",
    "check:repos": "node scripts/check-repos.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-yoshida-dev/works.git"
  },
  "author": "n-yoshida-dev",
  "license": "MIT",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
